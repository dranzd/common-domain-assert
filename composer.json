{
    "name": "dranzd/common-domain-assert",
    "description": "Domain-Driven Design (DDD) assertion utilities for domain validation, extending webmozart/assert",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dranzd",
            "email": "dranzd@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Dranzd\\Common\\Domain\\Assert\\": "src/Domain/Assert/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dranzd\\Common\\Domain\\Assert\\Tests\\": "tests/Domain/Assert/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src tests --level=9",
        "cs-check": "phpcs --standard=PSR12 src tests",
        "cs-fix": "phpcbf --standard=PSR12 src tests"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
