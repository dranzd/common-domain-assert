{
    "name": "dranzd/common-domain-assert",
    "description": "Assertions for domain models: webmozart/assert plus a datetime check, behind one class you can extend with your own rules.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "assert",
        "assertion",
        "validation",
        "ddd",
        "domain-driven-design",
        "value-object",
        "webmozart"
    ],
    "homepage": "https://github.com/dranzd/common-domain-assert",
    "authors": [
        {
            "name": "Dranzd",
            "email": "dranzd@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/dranzd/common-domain-assert/issues",
        "source": "https://github.com/dranzd/common-domain-assert"
    },
    "require": {
        "php": "^8.3",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5.4",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dranzd\\Common\\Domain\\Assert\\": "src/Domain/Assert/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dranzd\\Common\\Domain\\Assert\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=build/clover.xml",
        "phpstan": "phpstan analyse --no-progress",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "test:coverage": "Run the test suite with a coverage report (needs pcov or xdebug)",
        "phpstan": "Run PHPStan static analysis",
        "cs-check": "Check coding standards (PSR-12)",
        "cs-fix": "Fix coding standards violations",
        "check": "Run every quality gate"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
